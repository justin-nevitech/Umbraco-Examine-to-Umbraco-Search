      "values": [
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "23930894-c1b4-4ae2-9801-95505acd1054",
              "mediaKey": "c334997e-f9a7-498b-83af-f4888a97d5bc",
              "mediaTypeAlias": "Image",
              "crops": [],
