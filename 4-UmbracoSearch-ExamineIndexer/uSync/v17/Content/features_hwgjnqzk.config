  <Properties>
    <contentRows>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "8c57d1fc-1901-4c10-b75d-818f25b7df5d",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003ERich Text Row\u003C/h2\u003E\n\u003Cp\u003EThere is a simple rich text row for writing your usual formatted content in a WYSIWIG style with the usual settings including but not limited to:\u00A0\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EBold\u003C/strong\u003E\u003C/p\u003E\n\u003Cp\u003E\u003Cem\u003EItalic\u003C/em\u003E\u003C/p\u003E\n\u003Cp style=\u0022text-align: left;\u0022\u003ELeft align\u003C/p\u003E\n\u003Cp style=\u0022text-align: right;\u0022\u003ERight align\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003EBulleted List\u003C/li\u003E\n\u003C/ul\u003E\n\u003Col\u003E\n\u003Cli\u003EOrdered List\u003C/li\u003E\n\u003C/ol\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0df4794-063a-4450-8f4f-c615a5d902e2",
      "key": "daada397-d9a4-440a-be88-543c6c6ede2b",
      "values": [
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "b971579f-5dd9-46f4-ad32-1d4ea6f04127",
              "mediaKey": "bbf2800f-1cc5-4ea9-8d2e-b33ff1d5efbe",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Image Row Example"
        }
      ]
    },
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "452cbd00-8d6e-4c9f-bec8-9a53541bb89c",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EImage Row\u003C/h2\u003E\n\u003Cp\u003EYou can use the image row to render a full width image.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f43c8349-0801-44b8-9113-9f7c62cd44fe",
      "key": "4482c890-67f4-4943-bfe0-b92b07f78e80",
      "values": [
        {
          "alias": "videoUrl",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://www.youtube.com/watch?v=Dn2tI1--LOs"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s next in C# - Mads Torgersen @ Umbraco Codegarden 2022"
        }
      ]
    },
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "80e62051-60e6-4c2b-badc-c3759379134b",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003EVideo Row\u003C/h2\u003E\n\u003Cp\u003EThis lets you embed a YouTube video by just entering the normal URL of the video, and it just renders the preview image of it at first. Then when you click on it, it loads it in as the iframe, which is better for the end user as it doesn\u0027t download all of the YouTube assets until it is needed.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "1456e445-4048-4ae1-b72d-554024f1085b",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003ECode Snippet Row\u003C/h2\u003E\n\u003Cp\u003EThere is a code snippet row to enable you to easily share code snippets in your website.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f37c2c28-c8ab-48cd-ac07-b13e38bd900f",
      "key": "901e1674-4b91-4de1-a8cf-a81ef368c2dd",
      "values": [
        {
          "alias": "code",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "@inherits UmbracoViewPage\u003CBlockListItem\u003E\r\n@using Umbraco.Cms.Core.Models.Blocks\r\n\r\n@{\r\n    var row = Model.Content as CodeSnippetRow;\r\n    var settings = Model.Settings as CodeSnippetRowSettings;\r\n    if (settings?.Hide ?? false) { return; }\r\n\r\n    SmidgeHelper.RequiresJs(\u0022~/clean-assets/js/highlight.default.min.css\u0022);\r\n    SmidgeHelper.RequiresJs(\u0022~/clean-assets/js/highlight.min.js\u0022);\r\n}\r\n\r\n\u003Cdiv class=\u0022row clearfix\u0022\u003E\r\n    \u003Cdiv class=\u0022col-md-12 column\u0022\u003E\r\n        \u003Cpre\u003E\u003Ccode\u003E@row.Code\u003C/code\u003E\u003C/pre\u003E\r\n    \u003C/div\u003E\r\n\u003C/div\u003E"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Code from the codeSnippetRow.cshtml file"
        }
      ]
    },
