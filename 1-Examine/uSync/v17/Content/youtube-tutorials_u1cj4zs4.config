    <contentRows>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "0484f80f-b658-4260-9031-a8b0e816908c",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EThere are lots of free videos on YouTube for you to be able to learn more about Umbraco.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "86c6974e-c6f5-493c-a789-cb7a952da961",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003E\u003Ca rel=\u0022noopener\u0022 href=\u0022https://www.youtube.com/@UmbracoLearningBase\u0022 target=\u0022_blank\u0022\u003EUmbraco Learning Base\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EUmbraco Learning Base is the official channel for the Happy Documentation and TV team at Umbraco HQ. On this channel, you can find videos and tutorials on how to get started working with the world\u0027s friendliest CMS Umbraco.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f43c8349-0801-44b8-9113-9f7c62cd44fe",
      "key": "d81ad8b2-66d4-49ac-a32b-f283fb16c38e",
      "values": [
        {
          "alias": "videoUrl",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://www.youtube.com/watch?v=Yu29dE-0OoI"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Getting Started with Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "c42e05d9-0a04-4ca1-9bd0-03dc4169876c",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003E\u003Ca rel=\u0022noopener\u0022 href=\u0022https://www.youtube.com/@CodeSharePaul\u0022 target=\u0022_blank\u0022\u003EPaul Seal\u0027s YouTube Channel\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EThere are several playlists of videos in this channel for you to learn how to build a website with Umbraco. Paul takes you step by step through the process and shows you the errors and mistakes along the way so you can see how to fix them yourself.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f43c8349-0801-44b8-9113-9f7c62cd44fe",
      "key": "0b2960c5-5f9a-4e5a-9b7f-afa67e38c105",
      "values": [
        {
          "alias": "videoUrl",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://www.youtube.com/watch?v=xeWh9-56UzY"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Umbraco 13 Tutorial - Episode 1 - Introduction"
        }
      ]
    },
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "d077a674-1b1e-4520-99e9-44ed2ee5a07e",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch2\u003E\u003Ca rel=\u0022noopener\u0022 href=\u0022https://www.youtube.com/@jondjones\u0022 target=\u0022_blank\u0022\u003Ejondjones YouTube Channel\u003C/a\u003E\u003C/h2\u003E\n\u003Cp\u003EJon creates a new YouTube tutorial video every week, with a detailed blog post to follow along with too. He usually creates videos about Umbraco and other Content Management Systems.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "f43c8349-0801-44b8-9113-9f7c62cd44fe",
      "key": "87cae455-babf-4e64-95c2-7f664010b952",
      "values": [
        {
          "alias": "videoUrl",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "https://www.youtube.com/watch?v=arki6eMudG8"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Build a NextJs headless website with Umbraco and Content Delivery API"
        }
      ]
    }
