  <Properties>
    <contentRows>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "195ad6fb-5783-4dc5-bb75-1e98eb6f064c",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EThe Clean Starter Kit for Umbraco uses the Start Bootstrap Theme Clean Blog which is built using Bootstrap 5. It has been implemented in Umbraco as a Starter Kit by Paul Seal who has the blog \u003Ca rel=\u0022noopener\u0022 href=\u0022https://codeshare.co.uk\u0022 target=\u0022_blank\u0022\u003Ecodeshare.co.uk\u003C/a\u003E and works for the Umbraco Gold Partner \u003Ca rel=\u0022noopener\u0022 href=\u0022https://www.clerkswell.com\u0022 target=\u0022_blank\u0022\u003EClerksWell\u003C/a\u003E.\u003C/p\u003E\n\u003Cp\u003EThe idea of this starter kit is to provide you with a clean and simple website. It is ideally aimed at people who are new to Umbraco so they can install the starter kit, get used to Umbraco and then build upon the kit with their own requirements.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0df4794-063a-4450-8f4f-c615a5d902e2",
      "key": "f3bd9ab7-e33b-4eb6-91ec-5ff6e760c7d6",
      "values": [
        {
          "alias": "image",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "6041d253-db55-43e0-ad07-5e35f1bca9ea",
              "mediaKey": "8ac2c7bc-0acb-488e-a4e6-24d9ea5bdff7",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Umbraco, the friendly CMS"
        }
      ]
    },
    {
      "contentTypeKey": "dd183f78-7d69-4eda-9b4c-a25970583a28",
      "key": "9600adf3-2d0a-49e8-9ec4-cff9cc2844c5",
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWith this starter kit you should be able to quickly and easily set up a new website and share your content with others. The aim is for you to start using Umbraco and fall in love with it like I did, as a user or as a developer, you will find out how enjoyable it is to use.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
