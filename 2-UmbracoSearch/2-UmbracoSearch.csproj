<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SearchDemo</RootNamespace>
    <!-- Explicit, because the project name starts with a digit -->
    <AssemblyName>UmbracoSearchDemo</AssemblyName>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.7.1" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.7.1" />
    <!-- Paul Seal's Clean starter kit (7.x is the Umbraco 17 line) -->
    <PackageReference Include="Clean" Version="7.0.8" />
    <PackageReference Include="uSync" Version="17.4.3" />
    <!-- Umbraco Search add-on for Umbraco 17. Remove these three when upgrading to Umbraco 19. -->
    <PackageReference Include="Umbraco.Cms.Search.Core" Version="17.2.0" />
    <PackageReference Include="Umbraco.Cms.Search.BackOffice" Version="17.2.0" />
    <PackageReference Include="Umbraco.Cms.Search.Provider.Examine" Version="17.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <PropertyGroup>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>
</Project>
