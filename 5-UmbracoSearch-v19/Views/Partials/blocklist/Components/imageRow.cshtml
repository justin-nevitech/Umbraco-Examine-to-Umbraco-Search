@inherits UmbracoViewPage<BlockListItem>
@using Umbraco.Cms.Core.Models.Blocks
@using Clean.Core.Extensions

@{
    var row = Model.Content as ImageRow;
    var image = row?.Image?.FirstOrDefault();
    var settings = Model.Settings as ImageRowSettings;
    if (settings?.Hide ?? false) { return; }

    var spacingClasses = "";
    if (Model.Settings is ISpacingProperties spacing)
    {
        spacingClasses = Clean.Core.Helpers.SpacingHelper.GetSpacingClasses(spacing.PaddingTop?.FirstOrDefault(), spacing.PaddingBottom?.FirstOrDefault(), spacing.PaddingLeft?.FirstOrDefault(), spacing.PaddingRight?.FirstOrDefault(), spacing.MarginTop?.FirstOrDefault(), spacing.MarginBottom?.FirstOrDefault(), spacing.MarginLeft?.FirstOrDefault(), spacing.MarginRight?.FirstOrDefault());
    }
}

<div class="image @(spacingClasses)">
    <img src="@image?.Url()" alt="@image?.Content.GetAltText()" class="img-fluid">
    @if (!string.IsNullOrWhiteSpace(row.Caption))
    {
        <p class="caption">@row.Caption</p>
    }
</div>

